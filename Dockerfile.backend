# ── Build stage ─────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore (full source needed for transitive deps)
COPY backend/ .
RUN dotnet restore SlotMath.Api/SlotMath.Api.csproj

# Build
RUN dotnet publish SlotMath.Api/SlotMath.Api.csproj -c Release -o /app --no-restore

# ── Runtime stage ───────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

EXPOSE 8080

ENTRYPOINT ["dotnet", "SlotMath.Api.dll"]
