root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_prefer_braces = true
# Keep Rider cleanup consistent with the .NET brace and initializer rules above.
resharper_csharp_braces_for_ifelse = required
resharper_csharp_braces_for_for = required
resharper_csharp_braces_for_foreach = required
resharper_csharp_braces_for_while = required
resharper_csharp_braces_for_dowhile = required
resharper_csharp_braces_for_using = required
resharper_csharp_braces_for_lock = required
resharper_csharp_braces_for_fixed = required
resharper_csharp_wrap_object_and_collection_initializer_style = chop_always
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_constructors = when_on_single_line
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_expression_bodied_indexers = when_on_single_line
csharp_style_expression_bodied_accessors = when_on_single_line
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true

[SlotMath.Core/Math/Structured/*.cs]
# Match the structured evaluator's existing Rider switch and label layout.
csharp_indent_case_contents_when_block = false
csharp_indent_labels = no_change

[SlotMath.Core.Tests/Math/Structured/StructuredEquivalenceTests.cs]
# Match Rider's case-block layout in the structured equivalence gate.
csharp_indent_case_contents_when_block = false

[SlotMath.Core/Compiler/{SamplingExpressions,SamplingPlan}.cs]
# Match Rider's case-block layout for the sampling interpreter and plan.
csharp_indent_case_contents_when_block = false

[SlotMath.Core/Compiler/SamplingExpressions.cs]
# Preserve one switch arm per line in both Rider and dotnet format.
resharper_csharp_place_simple_switch_expression_on_single_line = false
resharper_csharp_wrap_switch_expression = chop_always
resharper_csharp_keep_existing_switch_expression_arrangement = false

[SlotMath.Core.Tests/Expressions/LexicalExpressionTests.cs]
resharper_csharp_place_simple_switch_expression_on_single_line = false
resharper_csharp_wrap_switch_expression = chop_always
resharper_csharp_keep_existing_switch_expression_arrangement = false

[SlotMath.Core/Compiler/Ir/*.cs]
# Match Rider's structured-region case-block layout in the compiler IR.
csharp_indent_case_contents_when_block = false
# Keep switch-expression arms consistent with the .NET formatter.
resharper_csharp_place_simple_switch_expression_on_single_line = false
resharper_csharp_wrap_switch_expression = chop_always
resharper_csharp_keep_existing_switch_expression_arrangement = false
