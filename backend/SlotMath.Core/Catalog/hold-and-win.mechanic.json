{
  "name": "hold-and-win",
  "description": "Hold & Win / Bonus Collect mechanic. Reveal cells on each respin collecting money symbols into state. Uses the collect transform to accumulate symbol values and the reveal transform to expose cells. Input port: 'board' (Board). Output port: 'wins' (Wins).",
  "nodes": [
    {
      "nodeType": "map",
      "id": "reveal",
      "label": "Reveal Cell",
      "transformId": "reveal",
      "inputs": { "board": { "name": "board", "type": "Board" } },
      "outputs": { "board": { "name": "board", "type": "Board" } }
    },
    {
      "nodeType": "map",
      "id": "collect",
      "label": "Collect Values",
      "transformId": "collect",
      "inputs": { "board": { "name": "board", "type": "Board" } },
      "outputs": { "wins": { "name": "wins", "type": "Wins" } }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "reveal",
      "sourcePort": "board",
      "targetNodeId": "collect",
      "targetPort": "board"
    }
  ],
  "expressions": {}
}
