{
  "name": "cascade",
  "description": "Cascade / tumble mechanic. In a loop: evaluate wins on the current board, remove winning cells, refill from above, repeat until no new wins. Composes remove-winning + refill-tumble transforms with a scatter or cluster evaluator. Input port: 'board' (Board). Output port: 'wins' (Wins).",
  "nodes": [
    {
      "nodeType": "map",
      "id": "remove",
      "label": "Remove Winning Cells",
      "transformId": "remove-winning",
      "inputs": { "board": { "name": "board", "type": "Board" } },
      "outputs": { "board": { "name": "board", "type": "Board" } }
    },
    {
      "nodeType": "map",
      "id": "refill",
      "label": "Refill / Tumble",
      "transformId": "refill-tumble",
      "inputs": { "board": { "name": "board", "type": "Board" } },
      "outputs": { "wins": { "name": "wins", "type": "Wins" } }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "remove",
      "sourcePort": "board",
      "targetNodeId": "refill",
      "targetPort": "board"
    }
  ],
  "expressions": {}
}
