<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlotMath.Api\SlotMath.Api.csproj" />
    <ProjectReference Include="..\SlotMath.Core\SlotMath.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="../SlotMath.Core.Tests/TestData/DogHouse/*.json" Link="TestData/DogHouse/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/fractional-model.json" Link="TestData/fractional-model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/measurement-model.json" Link="TestData/measurement-model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/component-accounting-model.json" Link="TestData/component-accounting-model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/numeric-input-model.json" Link="TestData/numeric-input-model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/interrupted-feature-model.json" Link="TestData/interrupted-feature-model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../frontend/e2e/fixtures/record-model.json" Link="TestData/record-model.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
